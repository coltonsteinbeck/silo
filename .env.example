# ================================================
# SILO DISCORD BOT - ENVIRONMENT CONFIGURATION
# ================================================
# Copy this file to .env and fill in your values
# Required fields are marked with [REQUIRED]

# ------------------------------------------------
# DEPLOYMENT MODE
# ------------------------------------------------
# Controls guild limits and feature restrictions
#
# Options:
#   'self-hosted'  - No limits (DEFAULT - recommended for self-hosters)
#   'development'  - No limits, for local testing
#   'production'   - Enforces guild limits, waitlist, inactivity eviction
#
# SELF-HOSTERS: Leave as 'self-hosted' or don't set at all
DEPLOYMENT_MODE=self-hosted

# ------------------------------------------------
# HOSTED SERVICE CONFIG (Ignore if self-hosting)
# ------------------------------------------------
# These are only needed if you're running your own hosted/SaaS version
# Self-hosters should leave these empty or remove them

# ================================================
# SUPABASE CONFIGURATION (if using Supabase)
# ================================================
# Supabase projects have prod and dev branches
# Each branch gets its own connection credentials

# Production Database (Supabase main branch)
# HOSTED_DB_IDENTIFIER=your-prod-project.supabase.co
# SUPABASE_PW=your-prod-postgres-password

# Development Database (Supabase preview branch)
# DEV_DB_IDENTIFIER=dev-your-project.supabase.co
# SUPABASE_DEV_PW=your-dev-postgres-password

# Auto-detect production by hostname (optional)
# PROD_HOSTNAME=your-production-server-hostname

# Maximum guilds for hosted mode (default: 5)
# MAX_HOSTED_GUILDS=5

# ------------------------------------------------
# DISCORD CONFIGURATION [REQUIRED]
# ------------------------------------------------
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
# Optional patch-note webhooks: base64-encoded random 32-byte key. Keep it stable
# and backed up with runtime secrets; losing it makes stored webhooks unusable.
PATCH_NOTES_ENCRYPTION_KEY=

# Optional: restrict slash command registration to a specific guild (faster for testing)
DISCORD_GUILD_ID=

# ------------------------------------------------
# APPLICATION IDENTITY / OBSERVABILITY
# ------------------------------------------------
# These values are attached to Langfuse traces and logs.
# Set them explicitly for each deployment to make traces easy to filter.
APP_NAME=silo
APP_ENV=development
# HOST_NAME defaults to your machine hostname if unset.
# For stable filtering across machines, set it explicitly.
HOST_NAME=hostname
# Prompt version identifies the deployed prompt family/version.
# This is separate from the runtime prompt hash used for effective prompt lineage.
PROMPT_VERSION=silo-local-dev

# ------------------------------------------------
# CONVERSATION SAFETY
# ------------------------------------------------
# Deterministic safety and provider moderation always run. Semantic Guardrails
# are risk-gated to suspicious input and risky/inherited assistant output.
OPENAI_MODERATION_ENABLED=true
OPENAI_GUARDRAILS_ENABLED=true
OPENAI_GUARDRAILS_MODEL=gpt-4.1-mini
# Per-user cooldown; assistant failures never activate a guild-wide switch.
SAFETY_MONITOR_ENABLED=true
SAFETY_BLOCK_THRESHOLD=3
SAFETY_WINDOW_MS=300000
SAFETY_KILL_SWITCH_ENABLED=true
SAFETY_KILL_SWITCH_DURATION_MS=600000
SAFETY_ALLOWED_PROMPT_HASHES=

# ------------------------------------------------
# AI PROVIDERS [REQUIRED - at least one]
# ------------------------------------------------
# OpenAI - https://platform.openai.com/api-keys
# Used for: text generation, image generation, voice, content moderation
# Default model: gpt-6-luna (supports reasoning tokens for improved accuracy)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna (default, with reasoning token support)
# OPENAI_IMAGE_MODEL=gpt-image-1 (default)

# xAI/Grok (optional) - https://console.x.ai/
XAI_API_KEY=

# ------------------------------------------------
# DATABASE [REQUIRED]
# ------------------------------------------------
# PostgreSQL connection string
# For local development with Docker: postgresql://silo:silo_dev@localhost:5432/silo
# For production: Use a secure password and consider SSL
DATABASE_URL=postgresql://silo:silo_dev@localhost:5432/silo

# Enable SSL for database connection (recommended for production)
DB_SSL=false

# Maximum database connections (default: 10)
DB_MAX_CONNECTIONS=10

# Prefer IPv4 when resolving the database hostname.
# Useful if your environment has broken IPv6 connectivity (some WSL/network setups).
DB_PREFER_IPV4=false

# ------------------------------------------------
# REDIS (Optional)
# ------------------------------------------------
# Used for caching and rate limiting
# If not available, falls back to in-memory storage (not recommended for production)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------
# SECURITY
# ------------------------------------------------
# Healthchecks.io ping URL for uptime monitoring
# Get your URL from https://healthchecks.io/ 
# Example: https://hc-ping.com/your-uuid-here
HEALTH_CHECK_SECRET=

# Discord webhook URL for security/error alerts (optional).
# Routine healthy checks are suppressed; Discord health posts are reserved for
# sustained outage, shutdown, and recovery after an alerted outage.
ALERT_WEBHOOK_URL=

# ------------------------------------------------
# RATE LIMITS
# ------------------------------------------------
# Commands per user per minute
RATE_LIMIT_COMMANDS_PER_USER=10

# AI requests per guild per minute
RATE_LIMIT_AI_REQUESTS_PER_GUILD=50

# Voice sessions per guild (concurrent)
RATE_LIMIT_VOICE_SESSIONS_PER_GUILD=3

# ------------------------------------------------
# FEATURES (Optional toggles)
# ------------------------------------------------
# Disable voice features if not needed
ENABLE_VOICE=true

# Optional radio-only override. Normal installs use the repository-pinned
# youtube-dl-exec binary, so production should usually leave this unset.
YTDLP_PATH=

# Disable image generation if not needed
ENABLE_IMAGES=true

# Enable monitoring/metrics (requires additional setup)
ENABLE_MONITORING=false

# Enable RAG (Retrieval-Augmented Generation) for memory features
# REQUIRES: OPENAI_API_KEY for embeddings (even if using xAI for chat)
# When disabled, /memory commands won't inject memories into conversations
ENABLE_RAG=false

# ------------------------------------------------
# LANGFUSE / TRACING (Optional)
# ------------------------------------------------
# Enable Langfuse tracing for message, interaction, and generation observability.
LANGFUSE_ENABLED=false
# Self-hosted example: https://langfuse.example.com
# Cloud example: https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional CLI alias. The app uses LANGFUSE_BASE_URL.
# LANGFUSE_HOST=https://langfuse.example.com

# Release/environment metadata used by Langfuse.
LANGFUSE_RELEASE=silo-local-dev
# Source revision for trace correlation. RELEASE_COMMIT takes precedence; when omitted,
# the app checks common CI variables such as GITHUB_SHA and CI_COMMIT_SHA.
RELEASE_COMMIT=
LANGFUSE_TRACING_ENVIRONMENT=development

# Queueing / batching controls.
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=5
LANGFUSE_EXPORT_MODE=batched

# Used to hash Discord user IDs before they are sent to Langfuse.
# Set this to a stable random string per deployment.
LANGFUSE_USER_HASH_SALT=replace-with-stable-random-value

# ------------------------------------------------
# BOUNDED AGENT GRAPH
# ------------------------------------------------
# Enabled by default. Use false/off/shadow only for emergency rollback or debugging.
AGENT_GRAPH_ENABLED=true
# Options: off, shadow, staging, on (active is accepted as a legacy alias)
AGENT_GRAPH_MODE=on
# Runtime graph and tool budgets.
AGENT_GRAPH_RECURSION_LIMIT=16
AGENT_GRAPH_MAX_TOOL_ROUNDS=1
AGENT_GRAPH_MAX_TOOL_CALLS=3
AGENT_GRAPH_MAX_WEB_SEARCHES=2
AGENT_GRAPH_MAX_PAGES_FETCHED=3
AGENT_GRAPH_MAX_IMAGE_GENERATIONS=1
AGENT_GRAPH_MAX_VIDEO_GENERATIONS=1
# Explicit /search command, independent of graph mode.
AGENT_SEARCH_ENABLED=false
# Natural-language image/video generation.
AGENT_MEDIA_NL_ENABLED=false
# Optional single search fallback: disabled, openai, xai.
# Refusals and invalid requests never trigger a fallback.
AGENT_SEARCH_FALLBACK_PROVIDER=disabled
