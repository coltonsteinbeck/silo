{
  "name": "silo",
  "version": "2.1.0",
  "packageManager": "bun@1.4.5",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "runtime:prepare": "bash scripts/prepare-radio-runtime.sh",
    "radio:verify-runtime": "bun scripts/verify-ytdlp-artifact.ts",
    "radio:validate": "bun scripts/validate-radio-playback.ts",
    "runtime:tls-memory": "node scripts/tls-memory-repro.mjs",
    "dev": "bun run --filter '*' dev",
    "dev:bot": "bun --watch packages/bot/src/index.ts",
    "predev:bot": "bun test",
    "start:prod": "bun packages/bot/src/shard.ts",
    "prestart:prod": "bun test",
    "start:pm2": "pm2 start ecosystem.config.json",
    "stop:pm2": "pm2 stop silo",
    "restart:pm2": "pm2 restart silo",
    "logs:pm2": "pm2 logs silo --lines 100",
    "logs:pm2:live": "pm2 logs silo --lines 50",
    "logs:pm2:error": "pm2 logs silo --err --lines 100",
    "logs:pm2:out": "pm2 logs silo --out --lines 100",
    "logs:file": "tail -n 100 logs/pm2-out.log",
    "logs:file:error": "tail -n 100 logs/pm2-error.log",
    "logs:file:live": "tail -f logs/pm2-out.log",
    "status:pm2": "pm2 status",
    "protect:env": "sh -c 'git ls-files --error-unmatch .env >/dev/null 2>&1 && git update-index --skip-worktree .env || echo \".env not tracked; skip-worktree not needed\"'",
    "pm2:logrotate:install": "pm2 install pm2-logrotate",
    "pm2:logrotate:configure": "pm2 set pm2-logrotate:rotateInterval '0 0 * * *' && pm2 set pm2-logrotate:retain 7 && pm2 set pm2-logrotate:compress true",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "test:regression": "/usr/bin/env -i PATH=\"$PATH\" HOME=\"$HOME\" bun --no-env-file test",
    "test:regression:database": "bun --no-env-file scripts/test-regression-postgres.ts",
    "test:discord-regression": "bun test packages/bot/src/__tests__/runtime/discord-regression.test.ts packages/bot/src/__tests__/services/current-status-search.test.ts packages/bot/src/__tests__/security/safety-regression.integration.test.ts packages/bot/src/__tests__/commands/draw.test.ts packages/bot/src/__tests__/database/postgres-conversation-turns.test.ts packages/bot/src/__tests__/database/quota-reservation-postgres.integration.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "langfuse:evals:safety": "bun packages/bot/src/evals/run-langfuse-safety-evals.ts",
    "migrate": "bash scripts/migrate.sh",
    "migrate:status": "bash scripts/migrate.sh --status",
    "migrate:dry-run": "bash scripts/migrate.sh --dry-run",
    "migrate:local": "bash scripts/migrate.sh --target local",
    "migrate:dev": "bash scripts/migrate.sh --target dev",
    "migrate:prod": "bash scripts/migrate.sh --target prod --confirm-prod",
    "migrate:remote": "bash scripts/migrate-universal.sh",
    "db:refresh:all": "bash scripts/refresh-prod-to-local-and-dev.sh",
    "db:refresh:branch": "bash scripts/refresh-prod-to-branch.sh",
    "type-check": "bun run --filter '*' type-check",
    "lint": "eslint packages --ext .ts",
    "lint:fix": "eslint packages --ext .ts --fix",
    "hygiene:check": "bun scripts/check-repo-hygiene.ts",
    "format": "prettier --write \"packages/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\"",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.6",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "ffmpeg-static",
    "youtube-dl-exec"
  ],
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@hono/node-server": "2.1.11",
    "proxy-addr": "2.0.8",
    "tar": "7.5.23",
    "hono": "4.13.22",
    "fast-uri": "3.1.9",
    "body-parser": "2.4.0",
    "form-data": "4.0.6",
    "ip-address": "10.7.6",
    "lodash": "4.18.1",
    "protobufjs": "8.8.1",
    "qs": "6.17.1",
    "undici": "6.29.1",
    "zod": "4.6.7",
    "@humanfs/node": "0.16.8",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@commitlint/config-validator": {
      "ajv": "8.20.0"
    },
    "glob": {
      "minimatch": "3.1.5"
    },
    "minimatch@^3": {
      "brace-expansion": "1.1.22"
    },
    "minimatch@^10": "11.0.9",
    "js-yaml": "4.3.2",
    "ws": "8.23.0"
  }
}
